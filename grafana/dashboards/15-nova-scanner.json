      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nova-memories-pg"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT created_at, source AS beat, left(text,90) AS transmission FROM memories WHERE source IN ('fire','rail','chp','scanner','atc','cb') ORDER BY created_at DESC LIMIT 25"
        }
      ]
