{
  "uid": "nova-signal-health",
  "title": "Nova \u2014 Signal & Alert Health",
  "tags": [
    "nova",
    "alerting",
    "signal",
    "health"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Signal vs Noise",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Alert decisions per hour (page / suppress / downgrade)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nova-ops-pg"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "calcs": [
            "last",
            "max"
          ],
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('hour',ts) AS time, decision AS metric, count(*) AS value FROM alert_triage_log WHERE $__timeFilter(ts) GROUP BY 1,2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Page rate (24h) %",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nova-ops-pg"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(100.0*count(*) FILTER (WHERE decision='page')::numeric/NULLIF(count(*),0),1) AS \"page %\" FROM alert_triage_log WHERE ts > now() - interval '24 hours'"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Alerts triaged (24h)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nova-ops-pg"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"alerts\" FROM alert_triage_log WHERE ts > now() - interval '24 hours'"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Pages per day by category (top 8)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nova-ops-pg"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "calcs": [
            "last",
            "max"
          ],
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day',ts) AS time, category AS metric, count(*) AS value FROM alert_triage_log WHERE decision='page' AND category IN (SELECT category FROM alert_triage_log WHERE decision='page' GROUP BY category ORDER BY count(*) DESC LIMIT 8) AND $__timeFilter(ts) GROUP BY 1,2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Top alert sources by pages (7d)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nova-ops-pg"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT source, count(*) AS pages FROM alert_triage_log WHERE decision='page' AND ts > now() - interval '7 days' GROUP BY source ORDER BY 2 DESC"
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Alert-source health",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "piechart",
      "title": "Freshness state (fresh / stale)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nova-ops-pg"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        },
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT state AS metric, count(*) AS value FROM freshness_state GROUP BY state ORDER BY 2 DESC"
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Currently-stale streams",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 18
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nova-ops-pg"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT stream_name, problem_kind, first_stale_ts, round(last_age_s::numeric,0) AS age_s, last_reason FROM freshness_state WHERE state='stale' ORDER BY first_stale_ts"
        }
      ]
    },
    {
      "id": 10,
      "type": "piechart",
      "title": "Cadence state (OK / SILENT / MISSING / ACKED_LOST)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nova-ops-pg"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        },
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT state AS metric, count(*) AS value FROM cadence_state GROUP BY state ORDER BY 2 DESC"
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Non-OK cadence streams",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 26
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nova-ops-pg"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT source, kind, state, last_seen, witness FROM cadence_state WHERE state <> 'OK' ORDER BY since"
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Open escalations (unacked)",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 34
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nova-ops-pg"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"open\" FROM escalation_state WHERE acked = false"
        }
      ]
    },
    {
      "id": 13,
      "type": "table",
      "title": "Escalations (pattern + count)",
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 6,
        "y": 34
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nova-ops-pg"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT recurrence_key AS pattern, escalate_count, last_pages, last_escalated_ts, acked FROM escalation_state ORDER BY escalate_count DESC"
        }
      ]
    }
  ]
}