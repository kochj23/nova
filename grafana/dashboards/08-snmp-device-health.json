{
  "uid": "snmp-device-health",
  "title": "Device Health (SNMP)",
  "tags": ["snmp", "health", "nova"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU Utilization % (UCD ssCpu)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["last", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
          "rawSql": "SELECT timestamp AS time, device_name AS metric, metric_value AS value FROM snmp_metrics WHERE metric_name = 'cpu_used_pct' AND $__timeFilter(timestamp) ORDER BY timestamp"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Load Average (5 min)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["last", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
          "rawSql": "SELECT timestamp AS time, device_name AS metric, metric_value AS value FROM snmp_metrics WHERE metric_name = 'cpu_load_5min' AND $__timeFilter(timestamp) ORDER BY timestamp"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Memory Used % (real)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["last", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
          "rawSql": "SELECT t.timestamp AS time, t.device_name AS metric, CASE WHEN t.metric_value > 0 THEN 100.0 * (t.metric_value - a.metric_value) / t.metric_value ELSE 0 END AS value FROM snmp_metrics t JOIN snmp_metrics a ON a.device_name = t.device_name AND a.metric_name = 'mem_avail_real' AND a.timestamp = t.timestamp WHERE t.metric_name = 'mem_total_real' AND $__timeFilter(t.timestamp) ORDER BY t.timestamp"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Temperatures (Synology system + UDM)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": { "defaults": { "unit": "celsius", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["last", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
          "rawSql": "SELECT timestamp AS time, device_name || ' system' AS metric, metric_value AS value FROM snmp_metrics WHERE metric_name = 'sys_temp' AND $__timeFilter(timestamp) ORDER BY timestamp"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Per-CPU Load % (hrProcessorLoad, latest)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
          "rawSql": "WITH latest AS (SELECT device_name, metric_value, row_number() OVER (PARTITION BY device_name ORDER BY timestamp DESC) rn FROM snmp_metrics WHERE metric_name = 'hr_cpu_load_avg' AND timestamp > now() - interval '15 min') SELECT device_name AS \"Device\", round(metric_value::numeric, 1) AS \"Avg CPU %\" FROM latest WHERE rn = 1 ORDER BY 2 DESC"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Uptime (latest)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": { "defaults": { "unit": "dtdurations" }, "overrides": [] },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
          "rawSql": "WITH latest AS (SELECT device_name, metric_value, row_number() OVER (PARTITION BY device_name ORDER BY timestamp DESC) rn FROM snmp_metrics WHERE metric_name = 'sys_uptime' AND timestamp > now() - interval '20 min') SELECT device_name AS \"Device\", metric_value / 100 AS \"Uptime\" FROM latest WHERE rn = 1 ORDER BY 2 DESC"
        }
      ]
    }
  ]
}
