        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT computed_at AS time, 'valence' AS metric, valence AS value FROM affect_state WHERE $__timeFilter(computed_at) UNION ALL SELECT computed_at, 'arousal', arousal FROM affect_state WHERE $__timeFilter(computed_at) ORDER BY 1"
