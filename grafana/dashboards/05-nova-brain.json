{
  "uid": "nova-brain",
  "title": "Nova Brain",
  "tags": ["nova", "memory", "llm", "scheduler", "queue"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-7d", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Memory",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total Memories",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-memories-pg" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "purple" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [ { "refId": "A", "format": "table", "rawQuery": true, "rawSql": "SELECT count(*) AS \"Memories\" FROM memories" } ]
    },
    {
      "id": 3,
      "type": "piechart",
      "title": "Memories by Tier",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-memories-pg" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "pieType": "donut", "legend": { "showLegend": true, "displayMode": "list", "placement": "right" } },
      "targets": [ { "refId": "A", "format": "table", "rawQuery": true, "rawSql": "SELECT tier AS metric, count(*) AS value FROM memories GROUP BY tier ORDER BY 2 DESC" } ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Top Sources (Vectors)",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-memories-pg" },
      "fieldConfig": { "defaults": {}, "overrides": [ { "matcher": { "id": "byName", "options": "Memories" }, "properties": [ { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } }, { "id": "color", "value": { "mode": "continuous-BlPu" } } ] } ] },
      "options": { "showHeader": true },
      "targets": [ { "refId": "A", "format": "table", "rawQuery": true, "rawSql": "SELECT source AS \"Source\", count(*) AS \"Memories\" FROM memories GROUP BY source ORDER BY 2 DESC LIMIT 12" } ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Memories Ingested per Day (stacked by source)",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-memories-pg" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 70, "lineWidth": 1, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "showLegend": true, "displayMode": "table", "calcs": ["sum"], "placement": "right" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "format": "time_series", "rawQuery": true, "rawSql": "SELECT date_trunc('day', created_at) AS time, source AS metric, count(*) AS value FROM memories WHERE source IN (SELECT source FROM memories GROUP BY source ORDER BY count(*) DESC LIMIT 10) AND $__timeFilter(created_at) GROUP BY 1, 2 ORDER BY 1" }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "LLM Inference",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Tokens per Hour by Model",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 1, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "showLegend": true, "displayMode": "table", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "format": "time_series", "rawQuery": true, "rawSql": "SELECT date_trunc('hour', timestamp) AS time, backend || '/' || COALESCE(model,'?') AS metric, sum(COALESCE(prompt_tokens,0) + COALESCE(completion_tokens,0)) AS value FROM inference_latency WHERE $__timeFilter(timestamp) GROUP BY 1, 2 ORDER BY 1" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Avg Latency by Backend (total_ms)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "pointSize": 5 } }, "overrides": [] },
      "options": { "legend": { "showLegend": true, "displayMode": "table", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "format": "time_series", "rawQuery": true, "rawSql": "SELECT date_trunc('hour', timestamp) AS time, backend AS metric, avg(total_ms) AS value FROM inference_latency WHERE total_ms IS NOT NULL AND $__timeFilter(timestamp) GROUP BY 1, 2 ORDER BY 1" }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Billable (OpenRouter) Tokens",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 24 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "green" }, "noValue": "0 (all inference is local)" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "value_and_name" },
      "targets": [
        { "refId": "A", "format": "table", "rawQuery": true, "rawSql": "SELECT COALESCE(sum(CASE WHEN backend ILIKE '%openrouter%' OR model ILIKE '%qwen3-235b%' THEN COALESCE(prompt_tokens,0)+COALESCE(completion_tokens,0) ELSE 0 END),0) AS \"Billable Tokens\", COALESCE(sum(CASE WHEN NOT (backend ILIKE '%openrouter%' OR model ILIKE '%qwen3-235b%') THEN COALESCE(prompt_tokens,0)+COALESCE(completion_tokens,0) ELSE 0 END),0) AS \"Local (Free) Tokens\" FROM inference_latency WHERE $__timeFilter(timestamp)" }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Inference Volume by Backend/Model",
      "gridPos": { "h": 5, "w": 16, "x": 8, "y": 24 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true },
      "targets": [
        { "refId": "A", "format": "table", "rawQuery": true, "rawSql": "SELECT backend AS \"Backend\", COALESCE(model,'?') AS \"Model\", count(*) AS \"Calls\", sum(COALESCE(prompt_tokens,0)+COALESCE(completion_tokens,0)) AS \"Tokens\", round(avg(total_ms)) AS \"Avg ms\", round(avg(ttft_ms)) AS \"Avg TTFT ms\", CASE WHEN backend ILIKE '%openrouter%' OR model ILIKE '%qwen3-235b%' THEN 'billable' ELSE 'free' END AS \"Cost\" FROM inference_latency WHERE $__timeFilter(timestamp) GROUP BY 1,2,7 ORDER BY 4 DESC NULLS LAST" }
      ]
    },
    {
      "id": 11,
      "type": "row",
      "title": "Web Searches",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Searches per Hour",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 30 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": { "defaults": { "unit": "short", "noValue": "No web searches recorded", "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 1 } }, "overrides": [] },
      "options": { "legend": { "showLegend": true, "displayMode": "list" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "format": "time_series", "rawQuery": true, "rawSql": "SELECT date_trunc('hour', created_at) AS time, COALESCE(backend,'unknown') AS metric, count(*) AS value FROM web_searches WHERE $__timeFilter(created_at) GROUP BY 1, 2 ORDER BY 1" }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Search Stats",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 30 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "noValue": "0", "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] } }, "overrides": [ { "matcher": { "id": "byName", "options": "Cache Hit %" }, "properties": [ { "id": "unit", "value": "percent" } ] }, { "matcher": { "id": "byName", "options": "Avg Latency" }, "properties": [ { "id": "unit", "value": "ms" } ] } ] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "value_and_name", "orientation": "horizontal" },
      "targets": [
        { "refId": "A", "format": "table", "rawQuery": true, "rawSql": "SELECT count(*) AS \"Total Searches\", round(avg(latency_ms)) AS \"Avg Latency\", round(100.0 * count(*) FILTER (WHERE cache_hit) / NULLIF(count(*),0), 1) AS \"Cache Hit %\" FROM web_searches WHERE $__timeFilter(created_at)" }
      ]
    },
    {
      "id": 14,
      "type": "row",
      "title": "Scheduler & Queue",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 37 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 15,
      "type": "table",
      "title": "Scheduler Tasks (runs / success / fail / avg duration)",
      "gridPos": { "h": 9, "w": 14, "x": 0, "y": 38 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": { "defaults": {}, "overrides": [ { "matcher": { "id": "byName", "options": "Fail" }, "properties": [ { "id": "custom.cellOptions", "value": { "type": "color-background" } }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "transparent", "value": null }, { "color": "red", "value": 1 } ] } } ] } ] },
      "options": { "showHeader": true, "sortBy": [ { "displayName": "Fail", "desc": true } ] },
      "targets": [
        { "refId": "A", "format": "table", "rawQuery": true, "rawSql": "SELECT task_id AS \"Task\", count(*) AS \"Runs\", count(*) FILTER (WHERE status='success') AS \"Success\", count(*) FILTER (WHERE status IN ('failure','timeout')) AS \"Fail\", round(avg(duration_ms)) AS \"Avg ms\", to_timestamp(max(started_at)/1000) AS \"Last Run\" FROM scheduler_runs WHERE started_at BETWEEN $__unixEpochFrom()::bigint*1000 AND $__unixEpochTo()::bigint*1000 GROUP BY task_id ORDER BY \"Fail\" DESC, \"Runs\" DESC LIMIT 30" }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Scheduler Failures over Time",
      "gridPos": { "h": 9, "w": 10, "x": 14, "y": 38 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 70, "lineWidth": 1 } }, "overrides": [ { "matcher": { "id": "byName", "options": "success" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] }, { "matcher": { "id": "byName", "options": "failure" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }, { "matcher": { "id": "byName", "options": "timeout" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] } ] },
      "options": { "legend": { "showLegend": true, "displayMode": "list" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "format": "time_series", "rawQuery": true, "rawSql": "SELECT date_trunc('hour', to_timestamp(started_at/1000)) AS time, status AS metric, count(*) AS value FROM scheduler_runs WHERE status IN ('failure','timeout') AND started_at BETWEEN $__unixEpochFrom()::bigint*1000 AND $__unixEpochTo()::bigint*1000 GROUP BY 1, 2 ORDER BY 1" }
      ]
    },
    {
      "id": 17,
      "type": "bargauge",
      "title": "Claude Queue — Open Items by Status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 47 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "format": "table", "rawQuery": true, "rawSql": "SELECT status AS metric, count(*) AS value FROM claude_queue WHERE status IN ('queued','in_progress') GROUP BY status ORDER BY 2 DESC" }
      ]
    },
    {
      "id": 18,
      "type": "table",
      "title": "Open Queue Items by Priority",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 47 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true },
      "targets": [
        { "refId": "A", "format": "table", "rawQuery": true, "rawSql": "SELECT priority AS \"Priority\", status AS \"Status\", count(*) AS \"Count\" FROM claude_queue WHERE status IN ('queued','in_progress') GROUP BY priority, status ORDER BY priority, status" }
      ]
    }
  ]
}
