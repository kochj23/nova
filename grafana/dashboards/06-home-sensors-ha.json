{
  "uid": "nova-home-sensors-ha",
  "title": "Home Sensors (HA)",
  "tags": ["nova", "telemetry", "home", "homeassistant"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Lowest Battery (live)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "orange", "value": 20 },
            { "color": "green", "value": 50 }
          ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "targets": [
        { "refId": "A", "format": "table", "rawQuery": true, "rawSql": "SELECT DISTINCT ON (entity_id) friendly_name AS metric, state_numeric AS value FROM telemetry.ha_sensors WHERE device_class='battery' AND state_numeric IS NOT NULL ORDER BY entity_id, ts DESC LIMIT 1" }
      ]
    },
    {
      "id": 2,
      "type": "table",
      "title": "Battery Levels (latest per device)",
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "Battery %" }, "properties": [
            { "id": "unit", "value": "percent" },
            { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } },
            { "id": "min", "value": 0 }, { "id": "max", "value": 100 },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [
              { "color": "red", "value": null }, { "color": "orange", "value": 20 }, { "color": "green", "value": 50 } ] } }
          ] }
        ]
      },
      "options": { "showHeader": true, "sortBy": [ { "displayName": "Battery %", "desc": false } ] },
      "targets": [
        { "refId": "A", "format": "table", "rawQuery": true, "rawSql": "SELECT DISTINCT ON (entity_id) friendly_name AS \"Device\", COALESCE(area,'-') AS \"Area\", state_numeric AS \"Battery %\", ts AS \"Last Seen\" FROM telemetry.ha_sensors WHERE device_class='battery' AND state_numeric IS NOT NULL ORDER BY entity_id, ts DESC" }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Low Battery Alert (<25%)",
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "Battery %" }, "properties": [
            { "id": "unit", "value": "percent" },
            { "id": "custom.cellOptions", "value": { "type": "color-background" } },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [
              { "color": "red", "value": null }, { "color": "orange", "value": 15 } ] } }
          ] }
        ]
      },
      "options": { "showHeader": true, "sortBy": [ { "displayName": "Battery %", "desc": false } ] },
      "targets": [
        { "refId": "A", "format": "table", "rawQuery": true, "rawSql": "SELECT * FROM (SELECT DISTINCT ON (entity_id) friendly_name AS \"Device\", COALESCE(area,'-') AS \"Area\", state_numeric AS \"Battery %\", ts AS \"Last Seen\" FROM telemetry.ha_sensors WHERE device_class='battery' AND state_numeric IS NOT NULL ORDER BY entity_id, ts DESC) q WHERE q.\"Battery %\" < 25 ORDER BY q.\"Battery %\" ASC" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Battery Levels Over Time",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["last", "min"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "format": "time_series", "rawQuery": true, "rawSql": "SELECT ts AS time, friendly_name AS metric, state_numeric FROM telemetry.ha_sensors WHERE device_class='battery' AND state_numeric IS NOT NULL AND $__timeFilter(ts) ORDER BY ts" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Illuminance (lux)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": { "defaults": { "unit": "lux", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "format": "time_series", "rawQuery": true, "rawSql": "SELECT ts AS time, friendly_name AS metric, state_numeric FROM telemetry.ha_sensors WHERE device_class='illuminance' AND state_numeric IS NOT NULL AND $__timeFilter(ts) ORDER BY ts" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Air Quality (PM2.5 / CO2 / VOC)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "format": "time_series", "rawQuery": true, "rawSql": "SELECT ts AS time, friendly_name AS metric, state_numeric FROM telemetry.ha_sensors WHERE device_class IN ('pm25','pm10','pm1','carbon_dioxide','carbon_monoxide','volatile_organic_compounds','volatile_organic_compounds_parts','nitrogen_dioxide','ozone','aqi') AND state_numeric IS NOT NULL AND $__timeFilter(ts) ORDER BY ts" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Sensor Temperature (F)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": { "defaults": { "unit": "fahrenheit", "custom": { "drawStyle": "line", "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "format": "time_series", "rawQuery": true, "rawSql": "SELECT ts AS time, friendly_name AS metric, state_numeric FROM telemetry.ha_sensors WHERE device_class='temperature' AND state_numeric IS NOT NULL AND $__timeFilter(ts) ORDER BY ts" }
      ]
    },
    {
      "id": 8,
      "type": "state-timeline",
      "title": "Motion / Occupancy / Contact Events",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 80, "lineWidth": 0 },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "clear", "color": "dark-blue" }, "1": { "text": "active", "color": "orange" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "dark-blue", "value": null }, { "color": "orange", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "mergeValues": true, "showValue": "never", "alignValue": "left", "rowHeight": 0.9, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "format": "time_series", "rawQuery": true, "rawSql": "SELECT ts AS time, friendly_name AS metric, state_numeric FROM telemetry.ha_sensors WHERE device_class IN ('motion','occupancy','door','window','opening','presence','vibration') AND state_numeric IS NOT NULL AND $__timeFilter(ts) ORDER BY ts" }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Lock States (latest)",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 32 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "State" }, "properties": [
            { "id": "custom.cellOptions", "value": { "type": "color-text" } },
            { "id": "mappings", "value": [
              { "type": "value", "options": { "locked": { "color": "green" }, "unlocked": { "color": "red" } } }
            ] }
          ] }
        ]
      },
      "options": { "showHeader": true },
      "targets": [
        { "refId": "A", "format": "table", "rawQuery": true, "rawSql": "SELECT DISTINCT ON (entity_id) friendly_name AS \"Lock\", COALESCE(area,'-') AS \"Area\", COALESCE(state_text, CASE WHEN state_numeric=0 THEN 'locked' WHEN state_numeric=1 THEN 'unlocked' END) AS \"State\", ts AS \"Last Seen\" FROM telemetry.ha_sensors WHERE domain='lock' OR device_class='lock' ORDER BY entity_id, ts DESC" }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Light & Switch States (latest)",
      "gridPos": { "h": 7, "w": 16, "x": 8, "y": 32 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "State" }, "properties": [
            { "id": "custom.cellOptions", "value": { "type": "color-text" } },
            { "id": "mappings", "value": [
              { "type": "value", "options": { "on": { "color": "green" }, "off": { "color": "dark-gray" } } }
            ] }
          ] }
        ]
      },
      "options": { "showHeader": true, "sortBy": [ { "displayName": "Domain", "desc": false } ] },
      "targets": [
        { "refId": "A", "format": "table", "rawQuery": true, "rawSql": "SELECT DISTINCT ON (entity_id) friendly_name AS \"Entity\", domain AS \"Domain\", COALESCE(area,'-') AS \"Area\", COALESCE(state_text,'') AS \"State\", state_numeric AS \"Brightness\", ts AS \"Last Seen\" FROM telemetry.ha_sensors WHERE domain IN ('light','switch') ORDER BY entity_id, ts DESC" }
      ]
    }
  ]
}
