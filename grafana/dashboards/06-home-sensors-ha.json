{
  "uid": "nova-home-sensors-ha",
  "title": "Home Sensors (HA)",
  "tags": ["nova", "telemetry", "home", "homeassistant"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Lowest Battery (live)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "orange", "value": 20 },
            { "color": "green", "value": 50 }
          ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "targets": [
        { "refId": "A", "format": "table", "rawQuery": true, "rawSql": "SELECT DISTINCT ON (entity_id) friendly_name AS metric, state_numeric AS value FROM telemetry.ha_sensors WHERE device_class='battery' AND state_numeric IS NOT NULL ORDER BY entity_id, ts DESC LIMIT 1" }
      ]
    },
    {
      "id": 2,
      "type": "table",
      "title": "Battery Levels (latest per device)",
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "Battery %" }, "properties": [
            { "id": "unit", "value": "percent" },
            { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } },
            { "id": "min", "value": 0 }, { "id": "max", "value": 100 },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [
              { "color": "red", "value": null }, { "color": "orange", "value": 20 }, { "color": "green", "value": 50 } ] } }
          ] }
        ]
      },
      "options": { "showHeader": true, "sortBy": [ { "displayName": "Battery %", "desc": false } ] },
      "targets": [
        { "refId": "A", "format": "table", "rawQuery": true, "rawSql": "SELECT DISTINCT ON (entity_id) friendly_name AS \"Device\", COALESCE(area,'-') AS \"Area\", state_numeric AS \"Battery %\", ts AS \"Last Seen\" FROM telemetry.ha_sensors WHERE device_class='battery' AND state_numeric IS NOT NULL ORDER BY entity_id, ts DESC" }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Low Battery Alert (<25%)",
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "Battery %" }, "properties": [
            { "id": "unit", "value": "percent" },
            { "id": "custom.cellOptions", "value": { "type": "color-background" } },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [
              { "color": "red", "value": null }, { "color": "orange", "value": 15 } ] } }
          ] }
        ]
      },
      "options": { "showHeader": true, "sortBy": [ { "displayName": "Battery %", "desc": false } ] },
      "targets": [
        { "refId": "A", "format": "table", "rawQuery": true, "rawSql": "SELECT * FROM (SELECT DISTINCT ON (entity_id) friendly_name AS \"Device\", COALESCE(area,'-') AS \"Area\", state_numeric AS \"Battery %\", ts AS \"Last Seen\" FROM telemetry.ha_sensors WHERE device_class='battery' AND state_numeric IS NOT NULL ORDER BY entity_id, ts DESC) q WHERE q.\"Battery %\" < 25 ORDER BY q.\"Battery %\" ASC" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Battery Levels Over Time",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["last", "min"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "format": "time_series", "rawQuery": true, "rawSql": "SELECT ts AS time, friendly_name AS metric, state_numeric FROM telemetry.ha_sensors WHERE device_class='battery' AND state_numeric IS NOT NULL AND $__timeFilter(ts) ORDER BY ts" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Illuminance (lux)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": { "defaults": { "unit": "lux", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "format": "time_series", "rawQuery": true, "rawSql": "SELECT ts AS time, friendly_name AS metric, state_numeric FROM telemetry.ha_sensors WHERE device_class='illuminance' AND state_numeric IS NOT NULL AND $__timeFilter(ts) ORDER BY ts" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Air Quality (PM2.5 / CO2 / VOC)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "format": "time_series", "rawQuery": true, "rawSql": "SELECT ts AS time, friendly_name AS metric, state_numeric FROM telemetry.ha_sensors WHERE device_class IN ('pm25','pm10','pm1','carbon_dioxide','carbon_monoxide','volatile_organic_compounds','volatile_organic_compounds_parts','nitrogen_dioxide','ozone','aqi') AND state_numeric IS NOT NULL AND $__timeFilter(ts) ORDER BY ts" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Sensor Temperature (F)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": { "defaults": { "unit": "fahrenheit", "custom": { "drawStyle": "line", "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "format": "time_series", "rawQuery": true, "rawSql": "SELECT ts AS time, friendly_name AS metric, state_numeric FROM telemetry.ha_sensors WHERE device_class='temperature' AND state_numeric IS NOT NULL AND $__timeFilter(ts) ORDER BY ts" }
      ]
    },
    {
      "id": 8,
      "type": "state-timeline",
      "title": "Motion / Occupancy / Contact Events",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 80, "lineWidth": 0 },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "clear", "color": "dark-blue" }, "1": { "text": "active", "color": "orange" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "dark-blue", "value": null }, { "color": "orange", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "mergeValues": true, "showValue": "never", "alignValue": "left", "rowHeight": 0.9, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "format": "time_series", "rawQuery": true, "rawSql": "SELECT ts AS time, friendly_name AS metric, state_numeric FROM telemetry.ha_sensors WHERE device_class IN ('motion','occupancy','door','window','opening','presence','vibration') AND state_numeric IS NOT NULL AND $__timeFilter(ts) ORDER BY ts" }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Lock States (latest)",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 32 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "State" }, "properties": [
            { "id": "custom.cellOptions", "value": { "type": "color-text" } },
            { "id": "mappings", "value": [
              { "type": "value", "options": { "locked": { "color": "green" }, "unlocked": { "color": "red" } } }
            ] }
          ] }
        ]
      },
      "options": { "showHeader": true },
      "targets": [
        { "refId": "A", "format": "table", "rawQuery": true, "rawSql": "SELECT DISTINCT ON (entity_id) friendly_name AS \"Lock\", COALESCE(area,'-') AS \"Area\", COALESCE(state_text, CASE WHEN state_numeric=0 THEN 'locked' WHEN state_numeric=1 THEN 'unlocked' END) AS \"State\", ts AS \"Last Seen\" FROM telemetry.ha_sensors WHERE domain='lock' OR device_class='lock' ORDER BY entity_id, ts DESC" }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Light & Switch States (latest)",
      "gridPos": { "h": 7, "w": 16, "x": 8, "y": 32 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "State" }, "properties": [
            { "id": "custom.cellOptions", "value": { "type": "color-text" } },
            { "id": "mappings", "value": [
              { "type": "value", "options": { "on": { "color": "green" }, "off": { "color": "dark-gray" } } }
            ] }
          ] }
        ]
      },
      "options": { "showHeader": true, "sortBy": [ { "displayName": "Domain", "desc": false } ] },
      "targets": [
        { "refId": "A", "format": "table", "rawQuery": true, "rawSql": "SELECT DISTINCT ON (entity_id) friendly_name AS \"Entity\", domain AS \"Domain\", COALESCE(area,'-') AS \"Area\", COALESCE(state_text,'') AS \"State\", state_numeric AS \"Brightness\", ts AS \"Last Seen\" FROM telemetry.ha_sensors WHERE domain IN ('light','switch') ORDER BY entity_id, ts DESC" }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Smart Lighting (Hue) & Energy",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Lights On",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 40 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "yellow" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [ { "refId": "A", "format": "table", "rawQuery": true, "rawSql": "SELECT COUNT(*) AS \"On\" FROM hue_light_state WHERE is_on = true" } ]
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Lights Off",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 40 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "dark-gray" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [ { "refId": "A", "format": "table", "rawQuery": true, "rawSql": "SELECT COUNT(*) AS \"Off\" FROM hue_light_state WHERE is_on = false" } ]
    },
    {
      "id": 23,
      "type": "stat",
      "title": "Unreachable",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 40 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [ { "refId": "A", "format": "table", "rawQuery": true, "rawSql": "SELECT COUNT(*) AS \"Unreachable\" FROM hue_light_state WHERE reachable = false" } ]
    },
    {
      "id": 24,
      "type": "piechart",
      "title": "Lights by Room",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "values": ["value"] }, "pieType": "donut", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "format": "table", "rawQuery": true, "rawSql": "SELECT room AS metric, COUNT(*) AS value FROM hue_light_state GROUP BY room ORDER BY value DESC" } ]
    },
    {
      "id": 25,
      "type": "table",
      "title": "Hue Lights by Room",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 44 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true },
      "targets": [ { "refId": "A", "format": "table", "rawQuery": true, "rawSql": "SELECT room AS \"Room\", name AS \"Light\", CASE WHEN is_on THEN 'ON' ELSE 'off' END AS \"State\", brightness AS \"Brightness\", CASE WHEN reachable THEN 'yes' ELSE 'NO' END AS \"Reachable\" FROM hue_light_state ORDER BY room, name" } ]
    },
    {
      "id": 26,
      "type": "row",
      "title": "JARVIS Presence & Activity",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 52 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 27,
      "type": "stat",
      "title": "Jordan Status",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 53 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "HOME": { "color": "green" }, "AWAY": { "color": "orange" } } } ] }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/.*/" }, "colorMode": "background", "textMode": "value" },
      "targets": [ { "refId": "A", "format": "table", "rawQuery": true, "rawSql": "SELECT CASE WHEN confidence > 0 THEN 'HOME' ELSE 'AWAY' END AS \"Status\" FROM telemetry.presence WHERE method = 'gps_tracker' AND person = 'jordan' ORDER BY ts DESC LIMIT 1" } ]
    },
    {
      "id": 28,
      "type": "stat",
      "title": "Current Activity",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 53 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/Activity/" }, "textMode": "value" },
      "targets": [ { "refId": "A", "format": "table", "rawQuery": true, "rawSql": "SELECT state AS \"Activity\" FROM telemetry.activity WHERE person = 'jordan' ORDER BY ts DESC LIMIT 1" } ]
    },
    {
      "id": 29,
      "type": "stat",
      "title": "Detection Methods (24h)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 53 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "format": "table", "rawQuery": true, "rawSql": "SELECT count(DISTINCT method) AS \"Methods\" FROM telemetry.presence WHERE ts > now() - interval '1 day'" } ]
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Room Presence Confidence (all methods)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 57 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 1, "custom": { "drawStyle": "points", "pointSize": 5 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["last"] }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "format": "time_series", "rawQuery": true, "rawSql": "SELECT ts AS time, room AS metric, max(confidence) AS value FROM telemetry.presence WHERE $__timeFilter(ts) AND confidence > 0 GROUP BY ts, room ORDER BY ts" } ]
    },
    {
      "id": 31,
      "type": "barchart",
      "title": "Presence Signals by Method (6h)",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 57 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "orientation": "horizontal", "legend": { "showLegend": false } },
      "targets": [ { "refId": "A", "format": "table", "rawQuery": true, "rawSql": "SELECT method AS \"Method\", count(*) AS \"Events\" FROM telemetry.presence WHERE ts > now() - interval '6 hours' GROUP BY method ORDER BY 2 DESC" } ]
    },
    {
      "id": 32,
      "type": "state-timeline",
      "title": "Activity Timeline (Jordan)",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 57 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "nova-ops-pg" },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 80 } }, "overrides": [] },
      "options": { "showValue": "auto", "mergeValues": true, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [ { "refId": "A", "format": "time_series", "rawQuery": true, "rawSql": "SELECT ts AS time, 'Activity' AS metric, state FROM telemetry.activity WHERE person = 'jordan' AND $__timeFilter(ts) ORDER BY ts" } ]
    }
  ]
}
