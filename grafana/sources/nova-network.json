    "sortBy": [
     {
      "desc": true,
      "displayName": "Total Errors"
     }
    ]
   },
   "targets": [
    {
     "format": "table",
     "rawQuery": true,
     "rawSql": "WITH latest AS (SELECT metric, metadata->>'device' AS device, metadata->>'port_name' AS port_name, (metadata->>'port')::int AS port, value, ts, row_number() OVER (PARTITION BY metric, metadata->>'device', metadata->>'port' ORDER BY ts DESC) rn FROM telemetry.unifi_metrics WHERE metric IN ('unifi_port_rx_errors','unifi_port_tx_errors','unifi_port_rx_dropped','unifi_port_tx_dropped')) SELECT device AS \"Device\", port AS \"Port\", port_name AS \"Port Name\", COALESCE(max(value) FILTER (WHERE metric='unifi_port_rx_errors'),0) AS \"RX Err\", COALESCE(max(value) FILTER (WHERE metric='unifi_port_tx_errors'),0) AS \"TX Err\", COALESCE(max(value) FILTER (WHERE metric='unifi_port_rx_dropped'),0) AS \"RX Drop\", COALESCE(max(value) FILTER (WHERE metric='unifi_port_tx_dropped'),0) AS \"TX Drop\", COALESCE(sum(value),0) AS \"Total Errors\" FROM latest WHERE rn=1 GROUP BY device, port, port_name HAVING COALESCE(sum(value),0) > 0 ORDER BY \"Total Errors\" DESC LIMIT 15",
     "refId": "A"
    }
   ],
   "title": "Switch Port Errors (Top Offenders)",
   "type": "table"
  },
