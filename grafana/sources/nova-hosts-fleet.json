  {
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "nova-ops-pg"
   },
   "description": "Latest telemetry.backup_runs for the Synology->UNAS job. Green = rc 0, no errors, bytes moved. Red = failed / errored / moved 0 bytes (the silent-green failure).",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "mappings": [
      {
       "options": {
        "0": {
         "color": "red",
         "text": "FAILED"
        },
        "1": {
         "color": "green",
         "text": "OK"
        }
       },
       "type": "value"
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 0,
    "y": 61
   },
   "id": 21,
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value"
   },
   "targets": [
    {
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT CASE WHEN ok AND COALESCE(bytes,0) > 0 THEN 1 ELSE 0 END AS \"Status\" FROM telemetry.backup_runs WHERE job = 'nova-backup:nas:incremental' ORDER BY ts DESC LIMIT 1;",
     "refId": "A"
    }
   ],
   "title": "NAS Backup \u2014 Last Run Status",
   "type": "stat"
