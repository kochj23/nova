   "targets": [
    {
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT t.timestamp AS time, t.device_name AS metric, 100.0 * (t.metric_value - a.metric_value) / NULLIF(t.metric_value, 0) AS mem_used_pct FROM snmp_metrics t JOIN snmp_metrics a ON a.device_ip = t.device_ip AND a.timestamp = t.timestamp AND a.metric_name = 'mem_avail_real' WHERE t.metric_name = 'mem_total_real' AND t.device_name IN ($device) AND $__timeFilter(t.timestamp) ORDER BY t.timestamp;",
     "refId": "A"
    }
   ],
   "title": "Memory Used % by Host",
