     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT timestamp AS time, 'CPU used' AS metric, metric_value AS value FROM snmp_metrics WHERE device_name='unas-pro' AND metric_name='cpu_used_pct' AND $__timeFilter(timestamp) ORDER BY timestamp",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "nova-ops-pg"
     },
     "editorMode": "code",
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT t.timestamp AS time, 'RAM used' AS metric, CASE WHEN tot.metric_value>0 THEN 100.0*(tot.metric_value-t.metric_value)/tot.metric_value ELSE 0 END AS value FROM snmp_metrics t JOIN snmp_metrics tot ON tot.timestamp=t.timestamp AND tot.device_name=t.device_name AND tot.metric_name='mem_total_real' WHERE t.device_name='unas-pro' AND t.metric_name='mem_avail_real' AND $__timeFilter(t.timestamp) ORDER BY t.timestamp",
     "refId": "A"
    }
   ],
