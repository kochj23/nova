    "showHeader": true
   },
   "targets": [
    {
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT probe AS \"Probe\", round((100.0 * sum(ok::int) / count(*))::numeric, 2) AS \"Uptime %\", count(*) AS \"Runs\", sum((NOT ok)::int) AS \"Failures\" FROM telemetry.probe_results WHERE ts >= now() - interval '24 hours' GROUP BY probe ORDER BY probe;",
     "refId": "A"
    }
   ],
   "title": "Uptime % per Probe (last 24h)",
   "type": "table"
  },
