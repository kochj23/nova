     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "nova-ops-pg"
     },
     "format": "table",
     "rawQuery": true,
     "rawSql": "WITH latest AS (SELECT device_name, metric_value, row_number() OVER (PARTITION BY device_name ORDER BY timestamp DESC) rn FROM snmp_metrics WHERE metric_name = 'hr_cpu_load_avg' AND timestamp > now() - interval '15 min') SELECT device_name AS \"Device\", round(metric_value::numeric, 1) AS \"Avg CPU %\" FROM latest WHERE rn = 1 ORDER BY 2 DESC",
     "refId": "A"
    }
   ],
