      "type": "grafana-postgresql-datasource",
      "uid": "${datasource}"
     },
     "editorMode": "code",
     "format": "time_series",
     "rawSql": "WITH d AS (\n  SELECT ts, datname,\n    (tup_inserted - lag(tup_inserted) OVER w) AS d_tup_inserted,\n    (tup_updated - lag(tup_updated) OVER w) AS d_tup_updated,\n    (tup_deleted - lag(tup_deleted) OVER w) AS d_tup_deleted,\n    extract(epoch FROM ts - lag(ts) OVER w) AS secs\n  FROM telemetry.pg_stat_db\n  WHERE $__timeFilter(ts)\n  WINDOW w AS (PARTITION BY datname ORDER BY ts)\n)\nSELECT ts AS time, 'inserted/s' AS metric, sum(d_tup_inserted/secs) AS value\nFROM d WHERE secs > 0 AND d_tup_inserted >= 0 GROUP BY ts\nUNION ALL\nSELECT ts AS time, 'updated/s' AS metric, sum(d_tup_updated/secs) AS value\nFROM d WHERE secs > 0 AND d_tup_updated >= 0 GROUP BY ts\nUNION ALL\nSELECT ts AS time, 'deleted/s' AS metric, sum(d_tup_deleted/secs) AS value\nFROM d WHERE secs > 0 AND d_tup_deleted >= 0 GROUP BY ts\nORDER BY time",
     "refId": "A"
