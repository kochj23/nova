     "rawSql": "WITH d AS (\n  SELECT ts, datname,\n    (temp_files - lag(temp_files) OVER w) AS d_temp_files,\n    extract(epoch FROM ts - lag(ts) OVER w) AS secs\n  FROM telemetry.pg_stat_db\n  WHERE $__timeFilter(ts)\n  WINDOW w AS (PARTITION BY datname ORDER BY ts)\n)\nSELECT ts AS time, 'temp files/s' AS metric, sum(d_temp_files/secs) AS value\nFROM d WHERE secs > 0 AND d_temp_files >= 0 GROUP BY ts\nORDER BY time",
     "refId": "A"
    }
   ],
