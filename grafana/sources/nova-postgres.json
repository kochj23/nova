   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "${datasource}"
   },
   "description": "Live commits / rollbacks / deadlocks per second, per-interval delta of pg_stat_database summed across DBs (telemetry.pg_stat_db, nova_pg_stat_poller).",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "axisPlacement": "auto",
      "drawStyle": "line",
      "fillOpacity": 12,
      "lineInterpolation": "smooth",
      "lineWidth": 2,
      "showPoints": "never",
      "spanNulls": true
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "unit": "ops"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 0,
    "y": 11
   },
   "id": 11,
   "options": {
    "legend": {
     "calcs": [
      "last",
      "max",
      "mean"
     ],
     "displayMode": "table",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "${datasource}"
     },
     "editorMode": "code",
     "format": "time_series",
     "rawSql": "WITH d AS (\n  SELECT ts, datname,\n    (xact_commit - lag(xact_commit) OVER w) AS d_xact_commit,\n    (xact_rollback - lag(xact_rollback) OVER w) AS d_xact_rollback,\n    (deadlocks - lag(deadlocks) OVER w) AS d_deadlocks,\n    extract(epoch FROM ts - lag(ts) OVER w) AS secs\n  FROM telemetry.pg_stat_db\n  WHERE $__timeFilter(ts)\n  WINDOW w AS (PARTITION BY datname ORDER BY ts)\n)\nSELECT ts AS time, 'commits/s' AS metric, sum(d_xact_commit/secs) AS value\nFROM d WHERE secs > 0 AND d_xact_commit >= 0 GROUP BY ts\nUNION ALL\nSELECT ts AS time, 'rollbacks/s' AS metric, sum(d_xact_rollback/secs) AS value\nFROM d WHERE secs > 0 AND d_xact_rollback >= 0 GROUP BY ts\nUNION ALL\nSELECT ts AS time, 'deadlocks/s' AS metric, sum(d_deadlocks/secs) AS value\nFROM d WHERE secs > 0 AND d_deadlocks >= 0 GROUP BY ts\nORDER BY time",
     "refId": "A"
    }
   ],
   "title": "Transaction rate",
   "type": "timeseries"
  },
