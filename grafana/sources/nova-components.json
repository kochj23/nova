     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "nova-ops-pg"
     },
     "format": "table",
     "rawSql": "WITH latest AS (SELECT *, row_number() OVER (PARTITION BY component, instance ORDER BY ts DESC) rn FROM telemetry.nova_components WHERE ts > now() - interval '15 minutes') SELECT component AS \"Component\", last_write_age_s AS \"Last Write Age (s)\", note AS \"Reason\" FROM latest WHERE rn = 1 AND up = 1 AND healthy = 0 ORDER BY last_write_age_s DESC NULLS LAST",
     "refId": "A"
