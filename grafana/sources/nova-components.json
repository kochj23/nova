   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "nova-ops-pg"
     },
     "format": "table",
     "rawSql": "WITH latest AS (SELECT *, row_number() OVER (PARTITION BY component, instance ORDER BY ts DESC) rn FROM telemetry.nova_components WHERE ts > now() - interval '15 minutes') SELECT component AS \"Component\", up AS \"Up\", healthy AS \"Healthy\", rss_mb AS \"RSS (MB)\", cpu_pct AS \"CPU %\", uptime_s AS \"Uptime (s)\", last_write_age_s AS \"Last Write Age (s)\", note AS \"Note\" FROM latest WHERE rn = 1 ORDER BY healthy ASC, up ASC, component ASC",
     "refId": "A"
    }
   ],
   "title": "Component Vitals (latest) \u2014 SNMP-style device table for Nova herself",
   "type": "table"
  },
  {
   "datasource": {
    "type": "grafana-postgresql-datasource",
