     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "nova-ops-pg"
     },
     "format": "table",
     "rawSql": "SELECT DISTINCT ON (device_mac) coalesce(device_name, device_mac) AS \"Device\", device_type AS \"Type\", rssi AS \"RSSI\", battery_pct AS \"Battery %\" FROM telemetry.bluetooth WHERE ts > now() - interval '10 min' ORDER BY device_mac, ts DESC",
     "refId": "A"
    }
   ],
