   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "nova-ops-pg"
     },
     "format": "time_series",
     "rawSql": "SELECT ts AS time, rssi AS value, coalesce(device_name, device_mac) AS metric FROM telemetry.bluetooth WHERE $__timeFilter(ts) AND device_mac IN (SELECT device_mac FROM telemetry.bluetooth WHERE ts > now() - interval '30 min' GROUP BY device_mac ORDER BY max(rssi) DESC LIMIT 10) ORDER BY ts",
     "refId": "A"
    }
   ],
