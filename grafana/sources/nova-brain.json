   "targets": [
    {
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT backend AS \"Backend\", COALESCE(model,'?') AS \"Model\", count(*) AS \"Calls\", sum(COALESCE(prompt_tokens,0)+COALESCE(completion_tokens,0)) AS \"Tokens\", round(avg(total_ms)) AS \"Avg ms\", round(avg(ttft_ms)) AS \"Avg TTFT ms\", CASE WHEN backend ILIKE '%openrouter%' OR model ILIKE '%qwen3-235b%' THEN 'billable' ELSE 'free' END AS \"Cost\" FROM inference_latency WHERE $__timeFilter(timestamp) GROUP BY 1,2,7 ORDER BY 4 DESC NULLS LAST",
     "refId": "A"
    }
   ],
   "title": "Inference Volume by Backend/Model",
   "type": "table"
