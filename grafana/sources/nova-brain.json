    {
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT COALESCE(sum(CASE WHEN backend ILIKE '%openrouter%' OR model ILIKE '%qwen3-235b%' THEN COALESCE(prompt_tokens,0)+COALESCE(completion_tokens,0) ELSE 0 END),0) AS \"Billable Tokens\", COALESCE(sum(CASE WHEN NOT (backend ILIKE '%openrouter%' OR model ILIKE '%qwen3-235b%') THEN COALESCE(prompt_tokens,0)+COALESCE(completion_tokens,0) ELSE 0 END),0) AS \"Local (Free) Tokens\" FROM inference_latency WHERE $__timeFilter(timestamp)",
     "refId": "A"
    }
   ],
   "title": "Billable (OpenRouter) Tokens",
   "type": "stat"
  },
