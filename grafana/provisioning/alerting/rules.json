                "from": 600,
                "to": 0
              },
              "datasourceUid": "nova-ops-pg",
              "model": {
                "refId": "A",
                "datasource": {
                  "type": "grafana-postgresql-datasource",
                  "uid": "nova-ops-pg"
                },
                "rawSql": "SELECT node_name AS metric, memory_percent AS value FROM node_status WHERE memory_percent IS NOT NULL AND node_name <> 'mac-mini'",
                "format": "table",
                "rawQuery": true,
                "editorMode": "code"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "reducer": "last",
                "expression": "A",
                "settings": {
                  "mode": "dropNN"
                }
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        90.0
                      ]
                    },
                    "type": "query"
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "10m",
          "labels": {
            "severity": "warning",
            "team": "nova"
          },
          "annotations": {
            "summary": "Node memory usage is above 90% (mac-mini excluded \u2014 its macOS SNMP misreports ~100%).",
            "description": "node_status.memory_percent exceeded 90% on a node (mac-mini intentionally excluded). Investigate memory pressure."
          },
          "isPaused": false
        }
      ]
    },
    {
      "orgId": 1,
      "name": "network-and-tasks",
      "folder": "Nova Network & Tasks",
      "interval": "2m",
      "rules": [
        {
          "uid": "nova_snmp_port_errors",
          "title": "SNMP interface errors rising",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "nova-ops-pg",
              "model": {
                "refId": "A",
                "datasource": {
                  "type": "grafana-postgresql-datasource",
                  "uid": "nova-ops-pg"
                },
                "rawSql": "SELECT device_name || ' ' || metric_name AS metric, (max(metric_value) - min(metric_value))::float8 AS value FROM snmp_metrics WHERE (metric_name LIKE 'if_in_errors%' OR metric_name LIKE 'if_out_errors%') AND timestamp > now() - interval '10 minutes' GROUP BY device_name, metric_name HAVING (max(metric_value) - min(metric_value)) > 0",
                "format": "table",
                "rawQuery": true,
                "editorMode": "code"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "reducer": "max",
                "expression": "A",
                "settings": {
                  "mode": "dropNN"
                }
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        1000.0
                      ]
                    },
                    "type": "query"
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "15m",
          "labels": {
            "severity": "warning",
            "team": "nova"
          },
          "annotations": {
            "summary": "A network interface is accumulating errors (>1000 new in/out errors over 10 minutes).",
            "description": "snmp_metrics if_in_errors/if_out_errors increased by more than 1000 on an interface over the last 10 minutes. Check the switch port / cabling."
          },
          "isPaused": false
        },
        {
          "uid": "nova_scheduler_task_failing",
          "title": "Scheduler task failing",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "nova-ops-pg",
              "model": {
                "refId": "A",
                "datasource": {
                  "type": "grafana-postgresql-datasource",
                  "uid": "nova-ops-pg"
                },
                "rawSql": "SELECT task_id AS metric, max(CASE WHEN status IN ('failure','timeout') THEN 1 ELSE 0 END)::float8 AS value FROM scheduler_runs WHERE started_at/1000.0 > extract(epoch from now()) - 1800 GROUP BY task_id HAVING max(CASE WHEN status IN ('failure','timeout') THEN 1 ELSE 0 END) = 1",
                "format": "table",
                "rawQuery": true,
                "editorMode": "code"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "reducer": "last",
                "expression": "A",
                "settings": {
                  "mode": "dropNN"
                }
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.0
                      ]
                    },
                    "type": "query"
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "5m",
          "labels": {
            "severity": "warning",
            "team": "nova"
          },
          "annotations": {
            "summary": "A scheduled task failed or timed out in the last 30 minutes.",
            "description": "scheduler_runs shows a task with status failure/timeout in the last 30 minutes. Check the task script and error_tail."
          },
          "isPaused": false
        }
      ]
    },
    {
      "orgId": 1,
      "name": "backup-health",
      "folder": "Nova Infrastructure",
      "interval": "5m",
      "rules": [
        {
          "uid": "nova_nas_backup_failed_or_stale",
          "title": "NAS backup failed or stale",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "nova-ops-pg",
              "model": {
                "refId": "A",
                "datasource": {
                  "type": "grafana-postgresql-datasource",
                  "uid": "nova-ops-pg"
                },
                "rawSql": "WITH last AS (SELECT * FROM telemetry.backup_runs WHERE job = 'nas_backup' ORDER BY ts DESC LIMIT 1), recent_ok AS (SELECT 1 FROM telemetry.backup_runs WHERE job = 'nas_backup' AND ok AND COALESCE(bytes,0) > 0 AND ts > now() - interval '25 hours' LIMIT 1) SELECT 'nas_backup' AS metric, CASE WHEN NOT EXISTS (SELECT 1 FROM last) THEN 1 WHEN NOT EXISTS (SELECT 1 FROM recent_ok) THEN 1 WHEN (SELECT COALESCE(rc,1) FROM last) <> 0 THEN 1 WHEN (SELECT COALESCE(bytes,0) FROM last) = 0 THEN 1 ELSE 0 END::float8 AS value",
                "format": "table",
                "rawQuery": true,
                "editorMode": "code"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "reducer": "last",
                "expression": "A",
                "settings": {
                  "mode": "dropNN"
                }
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.0
                      ]
                    },
                    "type": "query"
                  }
                ]
              }
            }
          ],
          "noDataState": "Alerting",
          "execErrState": "Error",
          "for": "5m",
          "labels": {
            "severity": "warning",
            "team": "nova"
          },
          "annotations": {
            "summary": "Synology->UNAS NAS backup failed, moved 0 bytes, or has not succeeded in 25h.",
            "description": "telemetry.backup_runs shows the nas_backup job is unhealthy: no successful run (rc=0, bytes>0) in the last 25 hours, OR the latest run has rc != 0, OR the latest run moved 0 bytes (the silent-green failure). The backup runs daily at 03:30 on the Synology and is ingested to PG on .6 by nova_backup_ingest. Check /volume1/homes/kochj/nova_nas_backup.log on the Synology and the backup_ingest scheduler task."
          },
          "isPaused": false
        }
      ]
    }
  ]
}