              "model": {
                "refId": "A",
                "datasource": {
                  "type": "grafana-postgresql-datasource",
                  "uid": "nova-ops-pg"
                },
                "rawSql": "SELECT node_name AS metric, disk_percent AS value FROM node_status WHERE disk_percent IS NOT NULL",
                "format": "table",
                "rawQuery": true,
                "editorMode": "code"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "reducer": "last",
                "expression": "A",
                "settings": {
                  "mode": "dropNN"
                }
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        85.0
                      ]
                    },
                    "type": "query"
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "10m",
          "labels": {
            "severity": "warning",
            "team": "nova"
          },
          "annotations": {
            "summary": "Node disk usage is above 85%.",
            "description": "node_status.disk_percent exceeded 85% on a node. Free space or expand storage."
          },
          "isPaused": false
        },
        {
          "uid": "nova_disk_crit",
          "title": "Disk usage > 95%",
          "condition": "C",
