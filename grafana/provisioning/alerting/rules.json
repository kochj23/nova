              },
              "datasourceUid": "nova-ops-pg",
              "model": {
                "refId": "A",
                "datasource": {
                  "type": "grafana-postgresql-datasource",
                  "uid": "nova-ops-pg"
                },
                "rawSql": "SELECT node_name AS metric, disk_percent AS value FROM node_status WHERE disk_percent IS NOT NULL",
                "format": "table",
                "rawQuery": true,
                "editorMode": "code"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "reducer": "last",
                "expression": "A",
                "settings": {
                  "mode": "dropNN"
                }
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        95.0
                      ]
                    },
                    "type": "query"
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "5m",
          "labels": {
            "severity": "critical",
            "team": "nova"
          },
          "annotations": {
            "summary": "Node disk usage is above 95% \u2014 imminent full disk.",
            "description": "node_status.disk_percent exceeded 95% on a node. Urgent: free space immediately."
          },
          "isPaused": false
        },
        {
          "uid": "nova_pg_replica_lag",
          "title": "PostgreSQL replica lag or disconnected",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "nova-ops-pg",
              "model": {
                "refId": "A",
                "datasource": {
                  "type": "grafana-postgresql-datasource",
                  "uid": "nova-ops-pg"
                },
                "rawSql": "SELECT COALESCE(application_name, 'replica') AS metric, COALESCE(EXTRACT(EPOCH FROM replay_lag), 0)::float8 AS value FROM pg_stat_replication UNION ALL SELECT 'no_replica_connected' AS metric, 9999::float8 AS value WHERE NOT EXISTS (SELECT 1 FROM pg_stat_replication)",
                "format": "table",
                "rawQuery": true,
                "editorMode": "code"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "reducer": "max",
                "expression": "A",
                "settings": {
                  "mode": "dropNN"
                }
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        5.0
                      ]
                    },
                    "type": "query"
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "2m",
          "labels": {
            "severity": "critical",
            "team": "nova"
          },
          "annotations": {
            "summary": "PostgreSQL streaming replica lag > 5s or no replica connected.",
            "description": "pg_stat_replication on the nova_ops primary shows replay_lag > 5s, or no replica is connected (value 9999). Check pg17-replica on nova-core."
          },
          "isPaused": false
        },
        {
          "uid": "nova_memory_warn",
