{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "infra-health",
      "folder": "Nova Infrastructure",
      "interval": "1m",
      "rules": [
        {
          "uid": "nova_node_down",
          "title": "Node down or heartbeat stale",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "nova-ops-pg",
              "model": {
                "refId": "A",
                "datasource": {
                  "type": "grafana-postgresql-datasource",
                  "uid": "nova-ops-pg"
                },
                "rawSql": "SELECT node_name AS metric, CASE WHEN status <> 'up' OR last_heartbeat IS NULL OR last_heartbeat < now() - interval '3 minutes' THEN 1 ELSE 0 END AS value FROM node_status",
                "format": "table",
                "rawQuery": true,
                "editorMode": "code"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "reducer": "last",
                "expression": "A",
                "settings": {
                  "mode": "dropNN"
                }
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.0
                      ]
                    },
                    "type": "query"
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "3m",
          "labels": {
            "severity": "critical",
            "team": "nova"
          },
          "annotations": {
            "summary": "A Nova node is down or its heartbeat is older than 3 minutes.",
            "description": "node_status reports a node with status != 'up' or a heartbeat staler than 3 minutes. Check the host and its telemetry agent."
          },
          "isPaused": false
        },
        {
          "uid": "nova_service_down",
          "title": "Service registry: service down",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "nova-ops-pg",
              "model": {
                "refId": "A",
                "datasource": {
                  "type": "grafana-postgresql-datasource",
                  "uid": "nova-ops-pg"
                },
                "rawSql": "SELECT service_name || '@' || node_name AS metric, 1 AS value FROM service_registry WHERE status = 'down'",
                "format": "table",
                "rawQuery": true,
                "editorMode": "code"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "reducer": "last",
                "expression": "A",
                "settings": {
                  "mode": "dropNN"
                }
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.0
                      ]
                    },
                    "type": "query"
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "10m",
          "labels": {
            "severity": "critical",
            "team": "nova"
          },
          "annotations": {
            "summary": "One or more registered Nova services report status=down.",
            "description": "service_registry has at least one service in 'down' state. Known intermittently-down: endpoint_monitor, hue. Investigate any unexpected entries."
          },
          "isPaused": false
        },
        {
          "uid": "nova_disk_warn",
