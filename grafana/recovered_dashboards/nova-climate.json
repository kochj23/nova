      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT c.ts as time, c.room, (c.temp_f - w.temp_f) as delta_f FROM telemetry.climate c JOIN LATERAL (SELECT temp_f FROM telemetry.weather WHERE ts <= c.ts AND temp_f IS NOT NULL ORDER BY ts DESC LIMIT 1) w ON true WHERE $__timeFilter(c.ts) AND c.temp_f IS NOT NULL ORDER BY c.ts",
          "refId": "A"
        }
      ],
      "title": "Indoor vs Outdoor Delta (\u00b0F)",
      "type": "timeseries"
