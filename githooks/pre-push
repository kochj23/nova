#!/bin/bash
# Global Git Pre-Push Security Scanner
# Installed: 2026-02-25
# Scans for credentials and PII before any push to remote

set -euo pipefail

ISSUES_FOUND=0
ISSUES=""

# Get the repo root
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
cd "$REPO_ROOT"

# --- Layer 1: Scan for hardcoded credentials ---

# AWS keys
if git ls-files | xargs grep -lE 'AKIA[A-Z0-9]{16}' 2>/dev/null | grep -vE 'test|mock|example|\.md$' | head -1 | grep -q .; then
    -e "rtsps\?://[^ ]*" \
    ISSUES+="  - AWS Access Key (AKIA...) found in source files\n"
    -e "rtsps\?://[^ ]*" \
    ISSUES_FOUND=1
fi

# OpenAI / Anthropic keys
if git ls-files | xargs grep -lE 'sk-[A-Za-z0-9]{20,}' 2>/dev/null | grep -vE 'test|mock|example|\.md$|SecurityScanner|AISecurityAnalyzer|SecureLogger' | head -1 | grep -q .; then
    ISSUES+="  - API key (sk-...) found in source files\n"
    ISSUES_FOUND=1
fi

# GitHub PATs
if git ls-files | xargs grep -lE 'ghp_[A-Za-z0-9]{36}' 2>/dev/null | grep -vE 'test|mock|example|\.md$|SecurityScanner' | head -1 | grep -q .; then
    ISSUES+="  - GitHub PAT (ghp_...) found in source files\n"
    ISSUES_FOUND=1
fi

# Slack tokens
if git ls-files | xargs grep -lE 'xox[bpoas]-[A-Za-z0-9-]+' 2>/dev/null | grep -vE 'test|mock|example|\.md$' | head -1 | grep -q .; then
    ISSUES+="  - Slack token found in source files\n"
    ISSUES_FOUND=1
fi

# --- Layer 2: Scan for PII ---

# Personal email addresses
# Exclusions: nova_daily_essay.py (PII-scrubbing regex patterns), nova_mail_handler.applescript (known-sender allowlist), herd_config.py (herd config)
if git ls-files -- '*.swift' '*.m' '*.h' '*.json' '*.plist' '*.md' '*.sh' '*.py' | xargs grep -lE 'kochjpar@gmail\.com|kochjpar@|jordan\.koch@disney\.com|kochj@digitalnoise\.net|kochj23@gmail\.com' 2>/dev/null | grep -vE 'SECURITY\.md|CONTRIBUTING\.md|nova_daily_essay\.py|nova_mail_handler\.applescript|herd_config\.py|herd_config\.template\.py' | head -1 | grep -q .; then
    ISSUES+="  - Personal email address found in source files\n"
    ISSUES_FOUND=1
fi

# Hardcoded home directory paths
# Exclusions: _disabled_voice plists (launchd configs), nova_slack_preprocessor_start.sh (exec path), nova_daily_essay.py (PII-scrubbing regex)
if git ls-files -- '*.swift' '*.m' '*.h' '*.sh' '*.py' '*.md' | xargs grep -lE '/Users/kochj/' 2>/dev/null | grep -vE 'CONTRIBUTING\.md|README\.md|_disabled_voice|nova_slack_preprocessor_start\.sh|nova_daily_essay\.py|nova_claude_bridge\.py' | head -1 | grep -q .; then
    ISSUES+="  - Hardcoded /Users/kochj/ path found in source files\n"
    ISSUES_FOUND=1
fi

# Plaintext passwords
if git ls-files -- '*.swift' '*.m' '*.json' '*.plist' '*.md' | xargs grep -lE 'Jkoogie|password.*=.*"[A-Za-z0-9!@#$%]{8,}"' 2>/dev/null | grep -vE 'test|mock|example|Keychain|forKey|SecurityScanner' | head -1 | grep -q .; then
    ISSUES+="  - Possible hardcoded password found\n"
    ISSUES_FOUND=1
fi

# Real MAC addresses (network inventory leak risk)
if git ls-files -- '*.md' '*.swift' '*.json' '*.plist' | xargs grep -lE '([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}' 2>/dev/null | grep -vE 'test|mock|example|DefaultCreds|SECURITY\.md|vendor' | head -1 | grep -q .; then
    ISSUES+="  - MAC address found in tracked files (network inventory leak risk)\n"
    ISSUES_FOUND=1
fi

# Network inventory / scan result files
if git ls-files | grep -qiE 'NETWORK.*INVENTORY|LIVE_TEST_REPORT|SCAN_RESULT'; then
    ISSUES+="  - Network inventory or live scan report file is tracked\n"
    ISSUES_FOUND=1
fi

# --- Layer 3: Check for files that should never be committed ---

if git ls-files | grep -qE '\.mobileprovision$|\.p12$|\.cer$|\.env$|secrets\.json|credentials\.json'; then
    ISSUES+="  - Sensitive file type (.mobileprovision, .p12, .env, etc.) is tracked\n"
    ISSUES_FOUND=1
fi

if git ls-files | grep -qE '^DerivedData/|^build/.*\.(o|d|dia|swiftmodule)$'; then
    ISSUES+="  - Build artifacts (DerivedData/build) are tracked in git\n"
    ISSUES_FOUND=1
fi

# --- Layer 4: Check repo visibility vs Disney content ---

IS_PRIVATE=$(gh repo view --json isPrivate -q '.isPrivate' 2>/dev/null || echo "unknown")

if [ "$IS_PRIVATE" = "false" ]; then
    # Check for Disney URLs in source code
    if git ls-files | xargs grep -lE 'disney\.com|chat\.gpt\.disney' 2>/dev/null | grep -vE '\.md$|README|SECURITY|^tests/|scripts/_archive/' | head -1 | grep -q .; then
        ISSUES+="  - Disney URL found in PUBLIC repo source code!\n"
        ISSUES_FOUND=1
    fi

    # Check for "DisneyGPT" name in ALL files (including .md, README)
    if git ls-files | xargs grep -lE 'DisneyGPT' 2>/dev/null | head -1 | grep -q .; then
        ISSUES+="  - \"DisneyGPT\" name found in PUBLIC repo (check all files including docs)!\n"
        ISSUES_FOUND=1
    fi
fi

# --- Report ---

if [ "$ISSUES_FOUND" -eq 1 ]; then
    echo "" >&2
    echo "╔══════════════════════════════════════════════════════════╗" >&2
    echo "║  SECURITY SCAN FAILED — Push blocked                    ║" >&2
    echo "╚══════════════════════════════════════════════════════════╝" >&2
    echo "" >&2
    echo "Issues found in $(basename "$REPO_ROOT"):" >&2
    echo -e "$ISSUES" >&2
    echo "Fix these issues before pushing." >&2
    echo "" >&2
    exit 1
fi

exit 0
