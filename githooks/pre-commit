#!/bin/bash
# Global Git Pre-Commit Security Scanner
# Installed: 2026-02-27
# Catches secrets BEFORE they enter git history (even local)
# This is Layer 0 — runs before pre-push hooks
#
# Why this matters: Even if you amend/rebase away a bad commit,
# the secret lives in git reflog for 90 days.

set -euo pipefail

ISSUES_FOUND=0
ISSUES=""

# Only scan staged files (what's about to be committed)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || echo "")

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

# Helper: scan staged files matching a pattern for a regex
scan_staged() {
    local file_pattern="$1"
    local regex="$2"
    local exclude_pattern="${3:-NOMATCH_PLACEHOLDER}"

    echo "$STAGED_FILES" | grep -E "$file_pattern" | while read -r file; do
        if [ -f "$file" ]; then
            # Use git show to read the STAGED version (not working tree)
            git show ":$file" 2>/dev/null | grep -E "$regex" | grep -vE "$exclude_pattern" && echo "$file" && return 0
        fi
    done
    return 1
}

# --- Credential Scanning ---

# AWS Access Keys (bulk scan removed -- per-file scan below is sufficient)

# More reliable: check each staged file individually
for file in $STAGED_FILES; do
    [ -f "$file" ] || continue

    # Get staged content
    CONTENT=$(git show ":$file" 2>/dev/null || continue)

    # Skip test/mock/example files for credential checks
    if echo "$file" | grep -qiE 'test|mock|example'; then
        continue
    fi

    # AWS keys
    if echo "$CONTENT" | grep -qE 'AKIA[A-Z0-9]{16}'; then
        ISSUES+="  - AWS Access Key (AKIA...) found in: $file\n"
        ISSUES_FOUND=1
    fi

    # OpenAI / Anthropic API keys
    if echo "$file" | grep -qvE 'SecurityScanner|AISecurityAnalyzer|SecureLogger'; then
        if echo "$CONTENT" | grep -qE 'sk-[A-Za-z0-9]{20,}'; then
            ISSUES+="  - API key (sk-...) found in: $file\n"
            ISSUES_FOUND=1
        fi
    fi

    # GitHub PATs
    if echo "$CONTENT" | grep -qE 'ghp_[A-Za-z0-9]{36}'; then
        ISSUES+="  - GitHub PAT (ghp_...) found in: $file\n"
        ISSUES_FOUND=1
    fi

    # Slack tokens
    if echo "$CONTENT" | grep -qE 'xox[bpoas]-[A-Za-z0-9-]+'; then
        ISSUES+="  - Slack token found in: $file\n"
        ISSUES_FOUND=1
    fi

    # Plaintext passwords (known patterns)
    if echo "$file" | grep -qvE 'Keychain|forKey|SecurityScanner'; then
        if echo "$CONTENT" | grep -vE 'password_hash|body\.get\("password"|request\.post|form.*password|\.get\(' | grep -qE 'Jkoogie|password.*=.*"[A-Za-z0-9!@#$%]{8,}"'; then
            ISSUES+="  - Possible hardcoded password in: $file\n"
            ISSUES_FOUND=1
        fi
    fi
done

# --- PII Scanning (only in relevant file types) ---

for file in $STAGED_FILES; do
    [ -f "$file" ] || continue

    # Only scan relevant file types for PII
    if ! echo "$file" | grep -qE '\.(swift|m|h|json|plist|md|sh|py)$'; then
        continue
    fi

    # Skip security policy files
    if echo "$file" | grep -qE 'SECURITY\.md|CONTRIBUTING\.md'; then
        continue
    fi

    CONTENT=$(git show ":$file" 2>/dev/null || continue)

    # Personal email addresses (all known patterns)
    if echo "$CONTENT" | grep -qE 'kochjpar@gmail\.com|kochjpar@|jordan\.koch@disney\.com|kochj@digitalnoise\.net|kochj23@gmail\.com'; then
        ISSUES+="  - Personal email address found in: $file\n"
        ISSUES_FOUND=1
    fi

    # Hardcoded home paths (skip tests, skill-workshop, and known-exclusion scripts)
    if echo "$file" | grep -qivE 'README\.md|CONTRIBUTING\.md|test|mock|example|skill-workshop/|nova_daily_essay\.py|nova_slack_preprocessor_start\.sh'; then
        if echo "$CONTENT" | grep -qE '/Users/kochj/'; then
            ISSUES+="  - Hardcoded /Users/kochj/ path in: $file\n"
            ISSUES_FOUND=1
        fi
    fi

    # Real MAC addresses
    if echo "$file" | grep -qivE 'test|mock|example|DefaultCreds|SECURITY\.md|vendor'; then
        # Strip documentation placeholders first (aa:bb:cc:dd:ee:ff, 00:00:00:00:00:00,
        # XX:XX:..., de:ad:be:ef:...). A scanner that cries wolf on an obvious example MAC
        # teaches people to reach for --no-verify, which is how a real one gets through.
        if echo "$CONTENT" \
             | grep -viE '(aa:bb:cc:dd:ee:ff|00:00:00:00:00:00|ff:ff:ff:ff:ff:ff|de:ad:be:ef|xx:xx:xx)' \
             | grep -qE '([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}'; then
            ISSUES+="  - MAC address found in: $file\n"
            ISSUES_FOUND=1
        fi
    fi
done

# --- Sensitive File Types (should never be committed) ---

if echo "$STAGED_FILES" | grep -qE '\.mobileprovision$|\.p12$|\.cer$|\.env$|secrets\.json|credentials\.json'; then
    ISSUES+="  - Sensitive file type staged for commit (.mobileprovision, .p12, .env, etc.)\n"
    ISSUES_FOUND=1
fi

if echo "$STAGED_FILES" | grep -qE '^DerivedData/|^build/.*\.(o|d|dia|swiftmodule)$'; then
    ISSUES+="  - Build artifacts staged for commit\n"
    ISSUES_FOUND=1
fi

# --- Log and backup files ---

if echo "$STAGED_FILES" | grep -qE '\.log$|build\.log|\.bak$|\.backup$'; then
    ISSUES+="  - Log or backup file staged for commit\n"
    ISSUES_FOUND=1
fi

# --- Network inventory files ---

if echo "$STAGED_FILES" | grep -qiE 'NETWORK.*INVENTORY|LIVE_TEST_REPORT|SCAN_RESULT'; then
    ISSUES+="  - Network inventory or scan report staged for commit\n"
    ISSUES_FOUND=1
fi

# --- Disney content in public repos ---

IS_PRIVATE=$(gh repo view --json isPrivate -q '.isPrivate' 2>/dev/null || echo "unknown")

if [ "$IS_PRIVATE" = "false" ]; then
    for file in $STAGED_FILES; do
        [ -f "$file" ] || continue
        CONTENT=$(git show ":$file" 2>/dev/null || continue)

        # Check for Disney URLs in source code (exclude docs, tests, archived scripts)
        if echo "$file" | grep -qvE '\.md$|README|SECURITY|^tests/|scripts/_archive/|skill-workshop/'; then
            if echo "$CONTENT" | grep -qE 'disney\.com|chat\.gpt\.disney'; then
                ISSUES+="  - Disney URL found in PUBLIC repo: $file\n"
                ISSUES_FOUND=1
            fi
        fi

        # Check for "DisneyGPT" name in ALL files (including .md)
        if echo "$CONTENT" | grep -qE 'DisneyGPT'; then
            ISSUES+="  - \"DisneyGPT\" name found in PUBLIC repo: $file\n"
            ISSUES_FOUND=1
        fi
    done
fi

# --- Report ---

if [ "$ISSUES_FOUND" -eq 1 ]; then
    echo "" >&2
    echo "╔══════════════════════════════════════════════════════════╗" >&2
    echo "║  PRE-COMMIT SCAN FAILED — Commit blocked               ║" >&2
    echo "║  Secrets caught BEFORE entering git history             ║" >&2
    echo "╚══════════════════════════════════════════════════════════╝" >&2
    echo "" >&2
    echo "Issues found:" >&2
    echo -e "$ISSUES" >&2
    echo "Fix these issues before committing." >&2
    echo "To bypass (emergencies only): git commit --no-verify" >&2
    echo "" >&2
    exit 1
fi

exit 0
