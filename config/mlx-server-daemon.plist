<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>net.digitalnoise.mlx-server</string>
  <key>UserName</key><string>kochj</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/mlx_lm.server</string>
    <string>--model</string><string>/Users/kochj/mlx-models/qwen2.5-32b-4bit</string>
    <string>--host</string><string>0.0.0.0</string>
    <string>--port</string><string>5050</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>HOME</key><string>/Users/kochj</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/Users/kochj/.openclaw/logs/mlx-server.log</string>
  <key>StandardErrorPath</key><string>/Users/kochj/.openclaw/logs/mlx-server-error.log</string>
</dict>
</plist>
