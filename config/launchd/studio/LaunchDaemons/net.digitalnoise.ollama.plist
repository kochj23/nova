<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>OLLAMA_CONTEXT_LENGTH</key>
		<string>32768</string>
		<key>OLLAMA_FLASH_ATTENTION</key>
		<string>1</string>
		<key>OLLAMA_HOST</key>
		<string>0.0.0.0</string>
		<key>OLLAMA_KEEP_ALIVE</key>
		<string>-1</string>
		<key>OLLAMA_MAX_LOADED_MODELS</key>
		<string>8</string>
		<key>OLLAMA_MODELS</key>
		<string>/Volumes/Data/ollama/models</string>
		<key>OLLAMA_NUM_PARALLEL</key>
		<string>2</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>net.digitalnoise.ollama</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>until [ -x /Volumes/Data/ollama/bin/ollama ]; do sleep 2; done; exec /Volumes/Data/ollama/bin/ollama serve</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__HOME__/.openclaw/logs/ollama.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/.openclaw/logs/ollama.log</string>
	<key>UserName</key>
	<string>kochj</string>
</dict>
</plist>
