<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>PYTHONPATH</key>
		<string>__HOME__/.openclaw/scripts</string>
	</dict>
	<key>GroupName</key>
	<string>staff</string>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>net.digitalnoise.daemon.nova-notifier</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/python3</string>
		<string>__HOME__/.openclaw/scripts/nova_notifier.py</string>
		<string>--daemon</string>
		<string>--interval</string>
		<string>5</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__HOME__/.openclaw/logs/nova-notifier.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/.openclaw/logs/nova-notifier.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>UserName</key>
	<string>kochj</string>
	<key>WorkingDirectory</key>
	<string>__HOME__/.openclaw/scripts</string>
</dict>
</plist>
