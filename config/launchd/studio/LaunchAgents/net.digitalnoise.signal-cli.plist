<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>net.digitalnoise.signal-cli</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/signal-cli</string>
        <string>-a</string>
        <string>+13233645436</string>
        <string>daemon</string>
        <string>--http</string>
        <string>192.168.1.6:8080</string>
        <string>--tcp</string>
        <string>192.168.1.6:7583</string>
        <string>--no-receive-stdout</string>
        <string>--ignore-stories</string>
        <string>--send-read-receipts</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>Crashed</key>
        <true/>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/.openclaw/logs/signal-cli.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.openclaw/logs/signal-cli.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
</dict>
</plist>
