<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>net.digitalnoise.nova-mac-share-mount</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>__HOME__/.openclaw/bin/nova_mac_share_mount.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__HOME__/.openclaw/logs/nova_mac_share_mount.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/.openclaw/logs/nova_mac_share_mount.log</string>
	<key>StartInterval</key>
	<integer>120</integer>
</dict>
</plist>
