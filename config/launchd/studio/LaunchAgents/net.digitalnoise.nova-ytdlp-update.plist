<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>net.digitalnoise.nova-ytdlp-update</string>
  <key>ProgramArguments</key>
  <array><string>__HOME__/.openclaw/bin/yt-dlp</string><string>-U</string></array>
  <key>StartCalendarInterval</key><dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>4</integer></dict>
  <key>StandardOutPath</key><string>__HOME__/.openclaw/logs/ytdlp_update.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.openclaw/logs/ytdlp_update.log</string>
</dict></plist>
