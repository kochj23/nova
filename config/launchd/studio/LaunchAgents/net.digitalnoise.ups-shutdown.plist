<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>net.digitalnoise.ups-shutdown</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>__HOME__/.openclaw/scripts/nova_ups_shutdown.py</string>
    </array>
    <key>StartInterval</key><integer>60</integer>
    <key>RunAtLoad</key><true/>
    <key>StandardOutPath</key><string>__HOME__/.openclaw/logs/ups_shutdown.out</string>
    <key>StandardErrorPath</key><string>__HOME__/.openclaw/logs/ups_shutdown.err</string>
</dict>
</plist>
