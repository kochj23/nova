<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>net.digitalnoise.go2rtc</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Volumes/Data/AI/go2rtc</string>
        <string>-config</string>
        <string>/Volumes/Data/AI/go2rtc.yaml</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>__HOME__/.openclaw/logs/go2rtc.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.openclaw/logs/go2rtc.log</string>
</dict>
</plist>
