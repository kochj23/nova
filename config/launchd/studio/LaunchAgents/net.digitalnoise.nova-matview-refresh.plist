<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>net.digitalnoise.nova-matview-refresh</string>
  <!-- Inline command, not scripts/nova_matview_refresh.sh: launchd's shells cannot read the NAS
       share under TCC ("Operation not permitted", exit 126 since the 2026-10-12 NAS cutover). -->
  <key>ProgramArguments</key><array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>for mv in telemetry.energy_hourly telemetry.weather_daily; do if psql -h localhost -U kochj -d nova_ops -qc "REFRESH MATERIALIZED VIEW $mv;"; then echo "[$(date '+%F %T')] refreshed $mv"; else echo "[$(date '+%F %T')] FAILED $mv"; fi; done</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>HOME</key><string>__HOME__</string>
  </dict>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__HOME__/.openclaw/logs/nova-matview-refresh.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.openclaw/logs/nova-matview-refresh.err</string>
</dict></plist>
