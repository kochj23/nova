<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>HOST</key>
		<string>192.168.1.6</string>
		<key>LLM_MODEL</key>
		<string>deepseek-r1:8b</string>
		<key>OPENAI_API_BASE</key>
		<string>http://192.168.1.6:11434/v1</string>
		<key>OPENAI_API_KEY</key>
		<string>ollama</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
		<key>PORT</key>
		<string>8000</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>net.digitalnoise.tinychat</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Volumes/Data/tinychat/venv/bin/python3</string>
		<string>run.py</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>__HOME__/.openclaw/logs/tinychat-error.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/.openclaw/logs/tinychat.log</string>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>WorkingDirectory</key>
	<string>/Volumes/Data/tinychat/chatbot</string>
</dict>
</plist>
