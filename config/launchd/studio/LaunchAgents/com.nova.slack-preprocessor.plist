<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.nova.slack-preprocessor</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>n=0; while ! T=$(security find-generic-password -a nova -s nova-slack-bot-token -w 2&gt;/dev/null) &amp;&amp; [ $n -lt 8 ]; do sleep 10; n=$((n+1)); done; [ -n "$T" ] || { echo "[preprocessor] keychain locked" &gt;&amp;2; exit 1; }; NOVA_SLACK_BOT_TOKEN="$T" exec /opt/homebrew/bin/python3 "$HOME/.openclaw/scripts/nova_slack_preprocessor.py"</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>__HOME__/.openclaw/logs/slack-preprocessor.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/.openclaw/logs/slack-preprocessor.log</string>
</dict>
</plist>
