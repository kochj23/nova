<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>NOVA_SLACK_BOT_TOKEN</key>
		<string>REDACTED-use-keychain</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.nova.slack-preprocessor</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>__HOME__/.openclaw/scripts/nova_slack_preprocessor_start.sh</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>__HOME__/.openclaw/logs/slack-preprocessor.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/.openclaw/logs/slack-preprocessor.log</string>
</dict>
</plist>
