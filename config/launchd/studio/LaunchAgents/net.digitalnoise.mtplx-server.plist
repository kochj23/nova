<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>net.digitalnoise.mtplx-server</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>__HOME__/.openclaw/scripts/mtplx_server_start.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>Crashed</key>
        <true/>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/.openclaw/logs/mtplx-server.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.openclaw/logs/mtplx-server.log</string>
    <key>WorkingDirectory</key>
    <string>__HOME__/.openclaw/scripts</string>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>ThrottleInterval</key>
    <integer>30</integer>
</dict>
</plist>
