<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.nova.fp300-bridge</string>
  <key>ProgramArguments</key><array>
    <string>/opt/homebrew/bin/python3</string>
    <string>__HOME__/.openclaw/scripts/nova_zigbee_presence_bridge.py</string>
  </array>
  <key>WorkingDirectory</key><string>__HOME__/.openclaw/scripts</string>
  <key>EnvironmentVariables</key><dict><key>PYTHONPATH</key><string>__HOME__/.openclaw/scripts</string></dict>
  <key>StandardOutPath</key><string>__HOME__/.openclaw/logs/nova-fp300-bridge.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.openclaw/logs/nova-fp300-bridge.log</string>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
</dict></plist>
