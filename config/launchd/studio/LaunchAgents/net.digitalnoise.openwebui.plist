<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>PATH</key>
		<string>/Volumes/Data/openwebui/venv/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>net.digitalnoise.openwebui</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>__HOME__/.openclaw/scripts/openwebui_start.sh</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>__HOME__/.openclaw/logs/openwebui/openwebui-error.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/.openclaw/logs/openwebui/openwebui.log</string>
	<key>ThrottleInterval</key>
	<integer>60</integer>
</dict>
</plist>
