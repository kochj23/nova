<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>net.digitalnoise.nova-face-gate-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>__HOME__/.openclaw/scripts/nova_face_gate_watch.py</string>
  </array>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__HOME__/.openclaw/logs/nova_face_gate_watch.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.openclaw/logs/nova_face_gate_watch.log</string>
  <key>EnvironmentVariables</key><dict><key>PYTHONPATH</key><string>__HOME__/.openclaw/scripts</string></dict>
</dict></plist>
