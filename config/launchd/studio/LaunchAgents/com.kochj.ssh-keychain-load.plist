<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kochj.ssh-keychain-load</string>
    <!-- After a reboot the ssh-agent is empty, so any tool relying on the
         passphrase-protected key (e.g. interactive ssh to the homelab) fails
         until the key is loaded by hand. Load all keychain-stored passphrases
         into the agent at login. Daemons should still use dedicated
         passphraseless keys (see Postgres WAL archive / id_pg_wal). -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/ssh-add</string>
        <string>--apple-load-keychain</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <key>StandardOutPath</key>
    <string>__HOME__/.openclaw/logs/ssh-keychain-load.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.openclaw/logs/ssh-keychain-load.log</string>
</dict>
</plist>
