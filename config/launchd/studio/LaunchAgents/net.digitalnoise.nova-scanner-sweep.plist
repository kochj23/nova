<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>net.digitalnoise.nova-scanner-sweep</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/python3</string>
		<string>__HOME__/.openclaw/scripts/nova_scanner_sweep.py</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>PYTHONPATH</key>
		<string>__HOME__/.openclaw/scripts</string>
	</dict>
	<key>StartCalendarInterval</key>
	<array>
		<dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
		<dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
	</array>
	<key>StandardOutPath</key>
	<string>__HOME__/.openclaw/logs/scanner-sweep.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/.openclaw/logs/scanner-sweep.log</string>
	<key>WorkingDirectory</key>
	<string>__HOME__/.openclaw/scripts</string>
</dict>
</plist>
