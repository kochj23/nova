<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>net.digitalnoise.nova-security-scan</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>__HOME__/.openclaw/scripts/nova_security_scan.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/.openclaw/logs/security_scan.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.openclaw/logs/security_scan.err</string>
    <key>WorkingDirectory</key>
    <string>__HOME__/.openclaw/scripts</string>
</dict>
</plist>
