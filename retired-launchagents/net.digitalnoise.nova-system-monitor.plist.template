<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>net.digitalnoise.nova-system-monitor</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>exec /opt/homebrew/bin/python3 __HOME__/.openclaw/scripts/nova_big_brother.py</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>NOVA_LOG_LEVEL</key>
        <string>info</string>
        <key>BB_DOMAIN</key>
        <string>system</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>__HOME__/.openclaw/scripts</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>Crashed</key>
        <true/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>__HOME__/.openclaw/logs/nova-system-monitor.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.openclaw/logs/nova-system-monitor.err.log</string>
</dict>
</plist>
